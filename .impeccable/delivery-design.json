  "title": "Design System: Forge Delivery Extension",
  "extensions": {
    "shadows": [{"name": "delivery-dialog", "value": "0 16px 48px rgba(24,27,24,.2)", "purpose": "Lift the native delivery editor above the working page."}],
    "breakpoints": [{"name": "delivery-compact", "value": "600px"}, {"name":"feedback-image-tight","value":"380px"}]
