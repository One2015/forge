  "components": [
    {
      "name": "Sheet Member Row",
      "kind": "custom",
      "description": "Flat sheet-local roster row. Native options have explicit labels; the final Owner's role/removal are disabled. Below 600px, controls stack beneath the person details.",
      "html": "<div class=\"ds-member-row\"><span class=\"ds-member-avatar\" aria-hidden=\"true\">示</span><div class=\"ds-member-copy\"><strong>示例成员</strong><span>参与生产与迭代</span></div><select aria-label=\"设置示例成员的数据单角色\"><option value=\"owner\" label=\"Owner\">Owner</option><option value=\"reviewer\" label=\"Reviewer\">Reviewer</option><option value=\"member\" label=\"Member\" selected>Member</option><option value=\"outsourcing\" label=\"Outsourcing\">Outsourcing</option></select><button type=\"button\" aria-label=\"移除成员示例成员\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z\"></path></svg></button></div>",
      "css": ".ds-member-row{display:flex;align-items:center;gap:10px;min-height:62px;padding:10px 0;border-bottom:1px solid var(--forge-border,#e3e5df);color:var(--forge-text,#272a25);font-family:var(--forge-font,Helvetica,sans-serif)}.ds-member-avatar{display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:var(--forge-subtle,#f6f6f3);color:var(--forge-muted,#666b61);flex:none;font-size:12px}.ds-member-copy{min-width:0;flex:1;overflow-wrap:anywhere}.ds-member-copy strong{display:block;font-size:13px;font-weight:500;line-height:20px}.ds-member-copy>span{display:block;font-size:12px;line-height:18px;color:var(--forge-muted,#666b61)}.ds-member-row select{min-width:0;width:128px;height:36px;flex:none;padding:7px 10px;border:1px solid var(--forge-control-border,#c9ccc4);border-radius:6px;background:var(--forge-panel,#fff);color:inherit;font-family:inherit;font-size:12px;line-height:20px}.ds-member-row button{display:inline-flex;align-items:center;justify-content:center;flex:none;width:28px;height:28px;padding:0;border:0;border-radius:5px;background:transparent;color:var(--forge-muted,#666b61);cursor:pointer}.ds-member-row :is(select,button):focus-visible{outline:2px solid var(--forge-accent,#c44318);outline-offset:2px}.ds-member-row select:disabled{background:var(--forge-disabled-bg,#eeefeb);color:var(--forge-disabled-text,#81877b);cursor:not-allowed}.ds-member-row button:disabled{color:var(--forge-disabled-text,#81877b);cursor:not-allowed}@media(max-width:600px){.ds-member-row{gap:8px;flex-wrap:wrap}.ds-member-copy{flex-basis:calc(100% - 42px)}.ds-member-row select{width:auto;flex:1;margin-left:38px}}@media(max-width:600px),(pointer:coarse){.ds-member-row select{height:44px}}@media(pointer:coarse){.ds-member-row button{width:44px;height:44px}}"
    },
    {
      "name": "Rework Image Box",
      "kind": "custom",
      "description": "Native multi-image chooser with visible uploaded and remaining capacity. Runtime paste, decoding, thumbnails and removal share a six-image cap. Full state sets data-disabled=true and disables the input.",
      "html": "<div class=\"ds-image-heading\"><span>参考图片 <span class=\"ds-image-optional\">选填</span></span><span class=\"ds-image-count\" role=\"status\" aria-live=\"polite\">已上传 0/6 张</span></div><label class=\"ds-image-box\" data-disabled=\"false\"><span class=\"ds-image-icon\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M216,40H40A16,16,0,0,0,24,56V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A16,16,0,0,0,216,40Zm0,16V158.75l-26.07-26.06a16,16,0,0,0-22.63,0l-20,20-44-44a16,16,0,0,0-22.62,0L40,149.37V56ZM40,172l52-52,80,80H40Zm176,28H194.63l-36-36,20-20L216,181.38V200ZM144,100a12,12,0,1,1,12,12A12,12,0,0,1,144,100Z\"></path></svg></span><span class=\"ds-image-copy\"><strong>点击上传图片</strong><span>还可上传 6 张</span><span>支持 Ctrl / ⌘ + V 粘贴图片</span></span><input type=\"file\" accept=\"image/png,image/jpeg,image/webp,image/gif\" multiple aria-label=\"上传返工参考图片\" aria-describedby=\"ds-image-help\"></label><p class=\"ds-image-help\" id=\"ds-image-help\">PNG、JPG、WebP、GIF · 最多 6 张 · 单张不超过 10 MB</p>",
      "css": ".ds-image-heading,.ds-image-box,.ds-image-help{font-family:var(--forge-font,Helvetica,sans-serif)}.ds-image-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:16px 0 8px;color:var(--forge-text,#272a25);font-size:13px;line-height:20px;font-weight:500}.ds-image-optional,.ds-image-count{font-size:12px;color:var(--forge-muted,#666b61);font-weight:400}.ds-image-optional{margin-left:4px}.ds-image-count{margin-left:auto;font-variant-numeric:tabular-nums}.ds-image-box{position:relative;display:flex;align-items:center;gap:14px;width:100%;min-height:108px;padding:16px;border:1px dashed var(--forge-control-border,#c9ccc4);border-radius:6px;background:var(--forge-subtle,#f6f6f3);cursor:pointer}.ds-image-icon{display:flex;align-items:center;justify-content:center;width:48px;height:48px;border:1px solid var(--forge-border,#e3e5df);border-radius:6px;background:var(--forge-panel,#fff);color:var(--forge-muted,#666b61);flex:none}.ds-image-copy{min-width:0;overflow-wrap:anywhere}.ds-image-copy strong{display:block;font-size:13px;line-height:20px;font-weight:500;color:var(--forge-text,#272a25)}.ds-image-copy>span{display:block;font-size:12px;line-height:18px;color:var(--forge-muted,#666b61);margin-top:2px}.ds-image-box input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}.ds-image-box:focus-within{outline:2px solid var(--forge-accent,#c44318);outline-offset:2px}.ds-image-box[data-disabled=true],.ds-image-box[data-disabled=true] input{cursor:not-allowed}.ds-image-box[data-disabled=true]{border-style:solid;background:var(--forge-disabled-bg,#eeefeb)}.ds-image-help{font-size:12px;color:var(--forge-muted,#666b61);margin:4px 0 0}@media(hover:hover){.ds-image-box:not([data-disabled=true]):hover{border-color:var(--forge-accent,#c44318);background:var(--forge-panel,#fff)}}@media(max-width:380px){.ds-image-box{padding:12px;gap:10px}.ds-image-icon{width:40px;height:40px}}"
    },
    {
      "name": "Skill Library Row",
      "kind": "custom",
      "description": "Flat multi-select result with a persistent command, source/version and selected state; uses the official Phosphor check geometry.",
      "html": "<button type=\"button\" class=\"ds-library-row\" aria-pressed=\"true\" aria-label=\"3D 轨迹评估，/3d trajectory，平台示例 · v1.0\" aria-describedby=\"ds-library-description\"><span class=\"ds-library-copy\"><strong>3D 轨迹评估</strong><span class=\"ds-library-command\">/3d trajectory</span><span id=\"ds-library-description\" class=\"ds-library-meta\">检查相机路径、视角覆盖与运动连续性。</span><span class=\"ds-library-meta\">平台示例 · v1.0</span></span><span class=\"ds-library-action\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M229.66,77.66l-128,128a8,8,0,0,1-11.32,0l-56-56a8,8,0,0,1,11.32-11.32L96,188.69,218.34,66.34a8,8,0,0,1,11.32,11.32Z\"></path></svg>已选择</span></button>",
      "css": ".ds-library-row{display:flex;align-items:center;justify-content:space-between;gap:16px;width:100%;min-height:76px;padding:10px 8px;border:0;border-bottom:1px solid var(--forge-border,#e3e5df);border-radius:0;background:var(--forge-panel,#fff);color:var(--forge-text,#272a25);font-family:var(--forge-font,Helvetica,sans-serif);line-height:18px;text-align:left;cursor:pointer}.ds-library-copy{min-width:0;flex:1}.ds-library-copy>strong{font-size:13px;font-weight:500;overflow-wrap:anywhere}.ds-library-command{margin-left:8px;font-size:12px;color:var(--forge-muted,#666b61);overflow-wrap:anywhere}.ds-library-meta{display:block;font-size:12px;color:var(--forge-muted,#666b61);overflow-wrap:anywhere}.ds-library-action{display:flex;align-items:center;gap:5px;min-width:60px;flex:none;font-size:12px}.ds-library-row[aria-pressed=true]{background:var(--forge-accent-soft,#fff1ea)}.ds-library-row[aria-pressed=true] .ds-library-action{color:var(--forge-accent,#c44318);font-weight:500}.ds-library-row:focus-visible{outline:2px solid var(--forge-accent,#c44318);outline-offset:-2px}.ds-library-row:disabled{cursor:not-allowed;color:var(--forge-disabled-text,#81877b)}.ds-library-row:disabled .ds-library-action{color:var(--forge-disabled-text,#81877b)}@media(hover:hover){.ds-library-row:not(:disabled):not([aria-pressed=true]):hover{background:var(--forge-subtle,#f6f6f3)}}@media(max-width:600px){.ds-library-row{gap:8px}.ds-library-command{display:block;margin-left:0}}"
    },
    {
      "name": "Review Call — Primary",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Inline, nonshrinking review action with fully opaque disabled colors.",
      "html": "<button type=\"button\" class=\"ds-primary\">调用</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;flex:0 0 auto;min-width:56px;min-height:36px;padding:0 12px;border:1px solid var(--forge-accent,#c44318);border-radius:6px;background:var(--forge-accent,#c44318);color:#fff;font-family:var(--forge-font,Helvetica,sans-serif);font-size:13px;font-weight:500;line-height:20px;cursor:pointer;white-space:nowrap}.ds-primary:focus-visible{outline:2px solid var(--forge-accent,#c44318);outline-offset:2px}.ds-primary:disabled{background:var(--forge-disabled-bg,#eeefeb);border-color:var(--forge-disabled-bg,#eeefeb);color:var(--forge-disabled-text,#81877b);cursor:not-allowed;opacity:1}@media(hover:hover){.ds-primary:not(:disabled):hover{background:var(--forge-accent-hover,#a83812);border-color:var(--forge-accent-hover,#a83812)}}@media(max-width:600px),(pointer:coarse){.ds-primary{min-height:44px}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet supporting actions such as Cancel or Add Tag.",
      "html": "<button type=\"button\" class=\"ds-secondary\">取消</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:0 12px;border:1px solid var(--forge-control-border,#c9ccc4);border-radius:6px;background:var(--forge-panel,#fff);color:var(--forge-text,#272a25);font-family:var(--forge-font,Helvetica,sans-serif);font-size:13px;font-weight:500;line-height:20px;cursor:pointer}.ds-secondary:focus-visible{outline:2px solid var(--forge-accent,#c44318);outline-offset:2px}.ds-secondary:disabled{background:var(--forge-disabled-bg,#eeefeb);border-color:var(--forge-disabled-bg,#eeefeb);color:var(--forge-disabled-text,#81877b);cursor:not-allowed}@media(hover:hover){.ds-secondary:not(:disabled):hover{background:var(--forge-subtle,#f6f6f3)}}@media(max-width:600px),(pointer:coarse){.ds-secondary{min-height:44px}}"
    },
    {
      "name": "Skill Command Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Invalid command with visible, programmatically linked field guidance.",
      "html": "<label class=\"ds-command-edit\"><span>/</span><input class=\"ds-input\" value=\"3d trajectory\" aria-label=\"Skill 调用名\" aria-invalid=\"true\" aria-describedby=\"ds-command-error\" maxlength=\"60\"></label><p class=\"ds-validation\" id=\"ds-command-error\">调用名重复，请为此 Skill 设置不同的名称。</p>",
      "css": ".ds-command-edit,.ds-validation{font-family:var(--forge-font,Helvetica,sans-serif)}.ds-command-edit{display:flex;align-items:center;gap:8px;margin:8px 0;color:var(--forge-muted,#666b61)}.ds-input{min-width:0;width:100%;height:36px;border:1px solid var(--forge-control-border,#c9ccc4);border-radius:6px;background:var(--forge-panel,#fff);color:var(--forge-text,#272a25);font-family:inherit;font-size:13px;line-height:20px;padding:7px 10px}.ds-input[aria-invalid=true]{border-color:var(--forge-accent,#c44318)}.ds-input:focus-visible{outline:2px solid var(--forge-accent,#c44318);outline-offset:2px}.ds-validation{font-size:12px;line-height:18px;color:var(--forge-accent,#c44318);margin:0 0 4px;overflow-wrap:anywhere}@media(pointer:coarse){.ds-input{font-size:16px;min-height:44px}}"
    },
    {
      "name": "Saved Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Default Tag color with computed white foreground; recompute contrast for other colors.",
      "html": "<span class=\"ds-tag\">重点验收</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;gap:5px;max-width:100%;padding:2px 7px;border-radius:4px;background:#64748b;color:#fff;font-family:var(--forge-font,Helvetica,sans-serif);font-size:12px;line-height:20px;overflow-wrap:anywhere}"
    },
    {
      "name": "Bound Skill Choice",
      "kind": "button",
      "refersTo": "skill-choice",
      "description": "Selected command retains source sheet to distinguish ambiguous bindings.",
      "html": "<button type=\"button\" class=\"ds-skill-choice\" aria-pressed=\"true\"><strong>/3d trajectory</strong><span>建筑验收 · 演示数据单</span></button>",
      "css": ".ds-skill-choice{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:32px;padding:6px 8px;border:0;border-radius:4px;background:var(--forge-subtle,#f6f6f3);color:var(--forge-text,#272a25);font-family:var(--forge-font,Helvetica,sans-serif);text-align:left;cursor:pointer}.ds-skill-choice[aria-pressed=true]{background:var(--forge-accent-soft,#fff1ea);color:var(--forge-accent,#c44318)}.ds-skill-choice strong{font-size:12px;font-weight:500;overflow-wrap:anywhere}.ds-skill-choice span{max-width:48%;font-size:12px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ds-skill-choice:focus-visible{outline:2px solid var(--forge-accent,#c44318);outline-offset:2px}@media(pointer:coarse){.ds-skill-choice{min-height:44px}}"
    }
  ],
  "narrative": {
    "northStar": "Compact Operate",
    "overview": "Extend the incumbent Forge interface with compact delivery configuration and bound review Skill controls. White panels, restrained orange actions, Chinese-capable sans typography and familiar native controls keep configuration subordinate to the working content.\n\nThis is a local surface contract, not a replacement global identity. Navigation, delivery metrics, review decisions and Phosphor icons remain unchanged.",
    "keyCharacteristics": ["Compact, task-first controls.", "Visible validation and persistent dialog actions.", "Explicit session-local and demonstration boundaries."],
    "rules": [{"name": "The Tag Contrast Rule", "body": "For each preset or custom Tag background, compute both pure-black and pure-white contrast and use the greater ratio. Do not substitute the interface text color or a brightness threshold.", "section": "colors"}],
    "dos": ["Do preserve the incumbent compact Forge identity.", "Do keep validation readable beside Save and linked to invalid Skill fields.", "Do preserve the 56px nonshrinking review Call action.", "Do choose Tag foregrounds by computed black/white contrast.", "Do keep session-local and demonstration limitations visible."],
    "donts": ["Don't replace global navigation, metrics or review decisions.", "Don't imply that a loaded Skill produced a real evaluation.", "Don't execute uploaded instructions or archive scripts.", "Don't add a second opacity reduction to the disabled review Call button.", "Don't hide the only validation explanation in a tooltip."]
  }
}
