{
  "schemaVersion": 2,
  "title": "Forge artifact preview",
  "extensions": {
    "artifactSource": "selected-item-and-run-manifest-only",
    "demoPreview": false,
    "localFilePreview": false,
    "deliveryHistory": {
      "headingDivider": false,
      "headingToRoundsGap": "8px",
      "versionSummary": false,
      "pendingCandidateTitleBadge": false,
      "preserveOtherStatusBadges": true,
      "emptyLabel": "尚未审核"
    },
    "focus": {
      "outline": "2px solid #f5f7f4",
      "outlineOffset": "3px",
      "nativeRadios": true,
      "inputFocusProxy": "label:has(input:focus-visible)"
    },
    "breakpoints": [
      {"name": "compact", "value": "(max-width:1000px)"},
      {"name": "stacked", "value": "(max-width:760px)"},
      {"name": "short", "value": "(max-width:760px) and (max-height:640px)"},
      {"name": "short-landscape", "value": "(min-width:600px) and (max-width:760px) and (max-height:640px)"}
    ],
    "motion": {
      "controlTransition": "none",
      "autoplay": false,
      "autoRotate": false,
      "cameraInterpolationDecay": 0,
      "reset": "jumpCameraToGoal"
    }
  }
}
