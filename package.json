{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test scripts/test-*.mjs",
    "dev": "npm run routes && npm run design-system && node scripts/build-summary-tooltips.mjs && node scripts/build-artifact-preview.mjs && vinext dev",
    "build": "npm run routes && npm run design-system && node scripts/build-summary-tooltips.mjs && node scripts/build-artifact-preview.mjs && vinext build",
    "routes": "node scripts/update-routing.mjs",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "design-system": "node scripts/update-geist-design-system.mjs && node scripts/design-system/gallery.mjs",
    "postman-ui": "node scripts/build-turbine-preview.mjs && node scripts/postman-ui/build.mjs",
    "dev:postman": "npm run postman-ui && VINEXT_NO_DEV_LOCK=1 vinext dev --hostname 127.0.0.1 --port 3011",
    "build:postman": "npm run postman-ui && vinext build"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@radix-ui/react-tooltip": "^1.2.16",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
